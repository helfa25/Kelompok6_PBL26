# Fastender Pre-Order Platform - .gitignore

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Log files
*.log
error_log

# Uploaded product & 3D files (preserve folders with .gitkeep)
uploads/products/*
!uploads/products/.gitkeep
uploads/3d/*
!uploads/3d/.gitkeep
